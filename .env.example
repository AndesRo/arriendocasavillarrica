# Copia este archivo como .env.local y completa los valores.
# Solo se usan variables VITE_* públicas. NUNCA pongas aquí la service_role key de Supabase.

# Supabase (opcional por ahora; sin esto el calendario muestra todo disponible)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contacto (también puedes editarlos directamente en src/data/property.ts)
# WhatsApp con código de país y solo dígitos, ej: 569XXXXXXXX
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
